{"text":"<link rel=\"stylesheet\" href=\"dashboard.css\">\n<div class=\"cr\" id=\"top\">\n  <header class=\"cr-head\">\n    <h1 class=\"cr-title dash-skeleton\" id=\"title\" data-source=\"header\" data-field=\"value\" data-where=\"fact=Title\">—</h1>\n    <p class=\"cr-lead dash-skeleton\" id=\"takeaway\" data-source=\"pareto-cut\" data-field=\"sentence\" data-row=\"0\">—</p>\n    <dl class=\"cr-facts\" id=\"facts\">\n      <div class=\"cr-fact\"><dt>Window</dt><dd class=\"dash-skeleton\" data-source=\"header\" data-field=\"value\" data-where=\"fact=Window\">—</dd></div>\n      <div class=\"cr-fact\"><dt>Scope</dt><dd class=\"dash-skeleton\" data-source=\"header\" data-field=\"value\" data-where=\"fact=Scope\">—</dd></div>\n      <div class=\"cr-fact\"><dt>Currency</dt><dd class=\"dash-skeleton\" data-source=\"header\" data-field=\"value\" data-where=\"fact=Currency\">—</dd></div>\n      <div class=\"cr-fact\"><dt>Source</dt><dd class=\"dash-skeleton\" data-source=\"header\" data-field=\"value\" data-where=\"fact=Source\">—</dd></div>\n      <div class=\"cr-fact\"><dt>Attribution</dt><dd class=\"dash-skeleton\" data-source=\"header\" data-field=\"value\" data-where=\"fact=Attribution\">—</dd></div>\n      <div class=\"cr-fact\"><dt>Totals</dt><dd class=\"dash-skeleton cr-completeness\" data-source=\"header\" data-field=\"value\" data-where=\"fact=Completeness\">—</dd></div>\n      <div class=\"cr-fact\"><dt>Generated</dt><dd class=\"dash-skeleton\" data-source=\"header\" data-field=\"value\" data-where=\"fact=Generated\">—</dd></div>\n    </dl>\n    <p class=\"cr-muted dash-skeleton\" id=\"previews-note\" data-source=\"header\" data-field=\"value\" data-where=\"fact=Previews\">—</p>\n  </header>\n\n  <nav class=\"cr-jump\" id=\"jump\" aria-label=\"Report sections\">\n    <a href=\"#overview\" data-section=\"overview\">Overview</a>\n    <a href=\"#pareto\" data-section=\"pareto\">Pareto</a>\n    <a href=\"#keep-kill\" data-section=\"keep-kill\">Keep / kill</a>\n    <a href=\"#format\" data-section=\"format\">Format</a>\n    <a href=\"#white-space\" data-section=\"white-space\">White space</a>\n    <a href=\"#briefing\" data-section=\"briefing\">Briefing</a>\n    <a href=\"#method\" data-section=\"method\">Method</a>\n  </nav>\n\n  <section class=\"cr-section\" id=\"overview\" aria-labelledby=\"overview-h\">\n    <h2 class=\"cr-h2\" id=\"overview-h\">Overview</h2>\n    <div class=\"cr-banner\" id=\"not-in-pull\" hidden>\n      <p class=\"cr-banner-title\">Not in this pull, so these read n/a for every ad</p>\n      <ul class=\"cr-list\" id=\"not-in-pull-list\" data-source=\"notes\" data-where=\"section=not-in-pull\"></ul>\n    </div>\n    <p class=\"cr-empty\" id=\"kpis-empty\" data-source=\"sections\" data-field=\"why\" data-where=\"panel=kpis\" hidden>—</p>\n    <p class=\"cr-muted\" id=\"kpis-how\" data-source=\"sections\" data-field=\"how\" data-where=\"panel=kpis\" hidden>—</p>\n    <div class=\"cr-kpis\" id=\"kpis\">\n      <div class=\"cr-kpi\" data-metric=\"spend\"><p class=\"cr-kpi-name\" data-source=\"kpis\" data-field=\"name\" data-where=\"metric=spend\">—</p><p class=\"cr-kpi-value dash-skeleton\" data-source=\"kpis\" data-field=\"shown\" data-where=\"metric=spend\">—</p><p class=\"cr-kpi-change\" data-source=\"kpis\" data-field=\"change_pct\" data-where=\"metric=spend\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"value_note\" data-where=\"metric=spend\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"detail\" data-where=\"metric=spend\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"change_pct_note\" data-where=\"metric=spend\" hidden>—</p><div class=\"cr-spark\" data-source=\"daily\" data-where=\"metric=spend\"></div></div>\n      <div class=\"cr-kpi\" data-metric=\"impressions\"><p class=\"cr-kpi-name\" data-source=\"kpis\" data-field=\"name\" data-where=\"metric=impressions\">—</p><p class=\"cr-kpi-value dash-skeleton\" data-source=\"kpis\" data-field=\"shown\" data-where=\"metric=impressions\">—</p><p class=\"cr-kpi-change\" data-source=\"kpis\" data-field=\"change_pct\" data-where=\"metric=impressions\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"value_note\" data-where=\"metric=impressions\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"detail\" data-where=\"metric=impressions\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"change_pct_note\" data-where=\"metric=impressions\" hidden>—</p><div class=\"cr-spark\" data-source=\"daily\" data-where=\"metric=impressions\"></div></div>\n      <div class=\"cr-kpi\" data-metric=\"reach\"><p class=\"cr-kpi-name\" data-source=\"kpis\" data-field=\"name\" data-where=\"metric=reach\">—</p><p class=\"cr-kpi-value dash-skeleton\" data-source=\"kpis\" data-field=\"shown\" data-where=\"metric=reach\">—</p><p class=\"cr-kpi-change\" data-source=\"kpis\" data-field=\"change_pct\" data-where=\"metric=reach\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"value_note\" data-where=\"metric=reach\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"detail\" data-where=\"metric=reach\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"change_pct_note\" data-where=\"metric=reach\" hidden>—</p><div class=\"cr-spark\" data-source=\"daily\" data-where=\"metric=reach\"></div></div>\n      <div class=\"cr-kpi\" data-metric=\"frequency\"><p class=\"cr-kpi-name\" data-source=\"kpis\" data-field=\"name\" data-where=\"metric=frequency\">—</p><p class=\"cr-kpi-value dash-skeleton\" data-source=\"kpis\" data-field=\"shown\" data-where=\"metric=frequency\">—</p><p class=\"cr-kpi-change\" data-source=\"kpis\" data-field=\"change_pct\" data-where=\"metric=frequency\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"value_note\" data-where=\"metric=frequency\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"detail\" data-where=\"metric=frequency\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"change_pct_note\" data-where=\"metric=frequency\" hidden>—</p><div class=\"cr-spark\" data-source=\"daily\" data-where=\"metric=frequency\"></div></div>\n      <div class=\"cr-kpi\" data-metric=\"ctr\"><p class=\"cr-kpi-name\" data-source=\"kpis\" data-field=\"name\" data-where=\"metric=ctr\">—</p><p class=\"cr-kpi-value dash-skeleton\" data-source=\"kpis\" data-field=\"shown\" data-where=\"metric=ctr\">—</p><p class=\"cr-kpi-change\" data-source=\"kpis\" data-field=\"change_pct\" data-where=\"metric=ctr\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"value_note\" data-where=\"metric=ctr\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"detail\" data-where=\"metric=ctr\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"change_pct_note\" data-where=\"metric=ctr\" hidden>—</p><div class=\"cr-spark\" data-source=\"daily\" data-where=\"metric=ctr\"></div></div>\n      <div class=\"cr-kpi\" data-metric=\"cpm\"><p class=\"cr-kpi-name\" data-source=\"kpis\" data-field=\"name\" data-where=\"metric=cpm\">—</p><p class=\"cr-kpi-value dash-skeleton\" data-source=\"kpis\" data-field=\"shown\" data-where=\"metric=cpm\">—</p><p class=\"cr-kpi-change\" data-source=\"kpis\" data-field=\"change_pct\" data-where=\"metric=cpm\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"value_note\" data-where=\"metric=cpm\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"detail\" data-where=\"metric=cpm\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"change_pct_note\" data-where=\"metric=cpm\" hidden>—</p><div class=\"cr-spark\" data-source=\"daily\" data-where=\"metric=cpm\"></div></div>\n      <div class=\"cr-kpi\" data-metric=\"conversions\"><p class=\"cr-kpi-name\" data-source=\"kpis\" data-field=\"name\" data-where=\"metric=conversions\">—</p><p class=\"cr-kpi-value dash-skeleton\" data-source=\"kpis\" data-field=\"shown\" data-where=\"metric=conversions\">—</p><p class=\"cr-kpi-change\" data-source=\"kpis\" data-field=\"change_pct\" data-where=\"metric=conversions\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"value_note\" data-where=\"metric=conversions\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"detail\" data-where=\"metric=conversions\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"change_pct_note\" data-where=\"metric=conversions\" hidden>—</p><div class=\"cr-spark\" data-source=\"daily\" data-where=\"metric=conversions\"></div></div>\n      <div class=\"cr-kpi\" data-metric=\"cpa\"><p class=\"cr-kpi-name\" data-source=\"kpis\" data-field=\"name\" data-where=\"metric=cpa\">—</p><p class=\"cr-kpi-value dash-skeleton\" data-source=\"kpis\" data-field=\"shown\" data-where=\"metric=cpa\">—</p><p class=\"cr-kpi-change\" data-source=\"kpis\" data-field=\"change_pct\" data-where=\"metric=cpa\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"value_note\" data-where=\"metric=cpa\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"detail\" data-where=\"metric=cpa\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"change_pct_note\" data-where=\"metric=cpa\" hidden>—</p><div class=\"cr-spark\" data-source=\"daily\" data-where=\"metric=cpa\"></div></div>\n      <div class=\"cr-kpi\" data-metric=\"conversion_value\"><p class=\"cr-kpi-name\" data-source=\"kpis\" data-field=\"name\" data-where=\"metric=conversion_value\">—</p><p class=\"cr-kpi-value dash-skeleton\" data-source=\"kpis\" data-field=\"shown\" data-where=\"metric=conversion_value\">—</p><p class=\"cr-kpi-change\" data-source=\"kpis\" data-field=\"change_pct\" data-where=\"metric=conversion_value\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"value_note\" data-where=\"metric=conversion_value\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"detail\" data-where=\"metric=conversion_value\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"change_pct_note\" data-where=\"metric=conversion_value\" hidden>—</p><div class=\"cr-spark\" data-source=\"daily\" data-where=\"metric=conversion_value\"></div></div>\n      <div class=\"cr-kpi\" data-metric=\"roas\"><p class=\"cr-kpi-name\" data-source=\"kpis\" data-field=\"name\" data-where=\"metric=roas\">—</p><p class=\"cr-kpi-value dash-skeleton\" data-source=\"kpis\" data-field=\"shown\" data-where=\"metric=roas\">—</p><p class=\"cr-kpi-change\" data-source=\"kpis\" data-field=\"change_pct\" data-where=\"metric=roas\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"value_note\" data-where=\"metric=roas\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"detail\" data-where=\"metric=roas\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"change_pct_note\" data-where=\"metric=roas\" hidden>—</p><div class=\"cr-spark\" data-source=\"daily\" data-where=\"metric=roas\"></div></div>\n      <div class=\"cr-kpi\" data-metric=\"hook_rate\"><p class=\"cr-kpi-name\" data-source=\"kpis\" data-field=\"name\" data-where=\"metric=hook_rate\">—</p><p class=\"cr-kpi-value dash-skeleton\" data-source=\"kpis\" data-field=\"shown\" data-where=\"metric=hook_rate\">—</p><p class=\"cr-kpi-change\" data-source=\"kpis\" data-field=\"change_pct\" data-where=\"metric=hook_rate\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"value_note\" data-where=\"metric=hook_rate\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"detail\" data-where=\"metric=hook_rate\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"change_pct_note\" data-where=\"metric=hook_rate\" hidden>—</p><div class=\"cr-spark\" data-source=\"daily\" data-where=\"metric=hook_rate\"></div></div>\n      <div class=\"cr-kpi\" data-metric=\"hold_rate\"><p class=\"cr-kpi-name\" data-source=\"kpis\" data-field=\"name\" data-where=\"metric=hold_rate\">—</p><p class=\"cr-kpi-value dash-skeleton\" data-source=\"kpis\" data-field=\"shown\" data-where=\"metric=hold_rate\">—</p><p class=\"cr-kpi-change\" data-source=\"kpis\" data-field=\"change_pct\" data-where=\"metric=hold_rate\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"value_note\" data-where=\"metric=hold_rate\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"detail\" data-where=\"metric=hold_rate\" hidden>—</p><p class=\"cr-kpi-note\" data-source=\"kpis\" data-field=\"change_pct_note\" data-where=\"metric=hold_rate\" hidden>—</p><div class=\"cr-spark\" data-source=\"daily\" data-where=\"metric=hold_rate\"></div></div>\n    </div>\n    <article class=\"cr-card\" id=\"time\">\n      <h3 class=\"cr-h3\">Performance over time</h3>\n      <p class=\"cr-muted\">Each measure by day, with a rolling average; a day with no data is a gap, not a zero. The faint bars are spend.</p>\n      <div class=\"cr-switch\" id=\"time-switch\" role=\"group\" aria-label=\"Measure\"></div>\n      <div class=\"cr-chart cr-chart-tall\" id=\"time-chart\" data-source=\"daily\"></div>\n      <p class=\"cr-empty\" id=\"time-empty\" data-source=\"sections\" data-field=\"why\" data-where=\"panel=time\" hidden>—</p>\n      <p class=\"cr-muted\" id=\"time-how\" data-source=\"sections\" data-field=\"how\" data-where=\"panel=time\" hidden>—</p>\n    </article>\n  </section>\n\n  <section class=\"cr-section\" id=\"pareto\" aria-labelledby=\"pareto-h\">\n    <h2 class=\"cr-h2\" id=\"pareto-h\">Pareto</h2>\n    <article class=\"cr-card\" id=\"pareto-card\">\n      <h3 class=\"cr-h3\">Where the value comes from</h3>\n      <p class=\"cr-lead dash-skeleton\" id=\"pareto-lead\" data-source=\"pareto-cut\" data-field=\"sentence\" data-row=\"0\">—</p>\n      <div class=\"cr-chart cr-chart-tall\" id=\"pareto-chart\" data-source=\"pareto\"></div>\n      <p class=\"cr-empty\" id=\"pareto-empty\" data-source=\"sections\" data-field=\"why\" data-where=\"panel=pareto\" hidden>—</p>\n      <p class=\"cr-muted\" id=\"pareto-how\" data-source=\"sections\" data-field=\"how\" data-where=\"panel=pareto\" hidden>—</p>\n      <div class=\"cr-stats\">\n        <div class=\"cr-stat\"><p class=\"cr-stat-name\">Ads in the head</p><p class=\"cr-stat-value dash-skeleton\" data-source=\"pareto-cut\" data-field=\"cut\" data-row=\"0\">—</p></div>\n        <div class=\"cr-stat\"><p class=\"cr-stat-name\">Share the cut must reach</p><p class=\"cr-stat-value dash-skeleton\" data-source=\"pareto-cut\" data-field=\"setting_pct\" data-row=\"0\">—</p></div>\n        <div class=\"cr-stat\"><p class=\"cr-stat-name\">Spend in the top ads</p><p class=\"cr-stat-value dash-skeleton\" data-source=\"pareto-cut\" data-field=\"concentration_pct\" data-row=\"0\">—</p><p class=\"cr-muted\" id=\"concentration-note\">—</p></div>\n        <div class=\"cr-stat\"><p class=\"cr-stat-name\">Long tail spend</p><p class=\"cr-stat-value dash-skeleton\" data-source=\"pareto-cut\" data-field=\"tail_spend\" data-row=\"0\">—</p></div>\n      </div>\n      <p class=\"cr-muted\">The cut is the fewest top-spend ads whose cumulative share reaches the set share. That share is a common convention, not a rule: set it from your own account when you rebuild the report.</p>\n    </article>\n    <article class=\"cr-card\">\n      <h3 class=\"cr-h3\">Ads ranked by spend</h3>\n      <div class=\"cr-scroll\">\n        <table class=\"cr-table\" id=\"pareto-table\" data-source=\"pareto\" data-row-key=\"ad_id\">\n          <thead><tr><th data-field=\"rank\" class=\"num\">Rank</th><th data-field=\"label\">Ad</th><th data-field=\"format\">Format</th><th data-field=\"spend\" class=\"num\">Spend</th><th data-field=\"conversion_value\" class=\"num\">Purchase value</th><th data-field=\"cum_spend_pct\" class=\"num\">Cumulative spend</th><th data-field=\"cum_basis_pct\" class=\"num\">Cumulative value</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </article>\n  </section>\n\n  <section class=\"cr-section\" id=\"keep-kill\" aria-labelledby=\"keep-kill-h\">\n    <h2 class=\"cr-h2\" id=\"keep-kill-h\">Keep / kill</h2>\n    <article class=\"cr-card\" id=\"board\">\n      <h3 class=\"cr-h3\">Verdict board</h3>\n      <p class=\"cr-muted\">Money at risk first. Pick a verdict to list only its ads below.</p>\n      <p class=\"cr-empty\" id=\"board-empty\" data-source=\"sections\" data-field=\"why\" data-where=\"panel=board\" hidden>—</p>\n      <p class=\"cr-muted\" id=\"board-how\" data-source=\"sections\" data-field=\"how\" data-where=\"panel=board\" hidden>—</p>\n      <table class=\"cr-table cr-board\" id=\"board-table\" data-source=\"verdict-board\" data-row-key=\"verdict_class\">\n        <thead><tr><th data-field=\"verdict\">Verdict</th><th data-field=\"ads\" class=\"num\">Ads</th><th data-field=\"spend_at_stake\" class=\"num\">Spend at stake</th><th data-field=\"check\">Check first</th></tr></thead>\n        <tbody></tbody>\n      </table>\n    </article>\n    <article class=\"cr-card\" id=\"all-ads\">\n      <h3 class=\"cr-h3\">All ads</h3>\n      <p class=\"cr-empty\" id=\"all-ads-empty\" data-source=\"sections\" data-field=\"why\" data-where=\"panel=all-ads\" hidden>—</p>\n      <p class=\"cr-muted\" id=\"all-ads-how\" data-source=\"sections\" data-field=\"how\" data-where=\"panel=all-ads\" hidden>—</p>\n      <div class=\"cr-switch\" id=\"verdict-filter\" role=\"group\" aria-label=\"Show ads with verdict\"></div>\n      <div class=\"cr-scroll cr-scroll-tall\">\n        <table class=\"cr-table\" id=\"verdict-table\" data-source=\"verdicts\" data-row-key=\"ad_id\">\n          <thead><tr><th data-field=\"label\">Ad</th><th data-field=\"format\">Format</th><th data-field=\"verdict\">Verdict</th><th data-field=\"confidence\">Confidence</th><th data-field=\"spend\" class=\"num\">Spend</th><th data-field=\"spend_at_stake\" class=\"num\">Spend at stake</th><th data-field=\"roas\" class=\"num\">ROAS</th><th data-field=\"cpa\" class=\"num\">CPA</th><th data-field=\"ctr\" class=\"num\">CTR</th><th data-field=\"hook_rate\" class=\"num\">Hook rate</th><th data-field=\"next_step\">Next step</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n      <p class=\"cr-muted\" id=\"images-note\" data-source=\"header\" data-field=\"value\" data-where=\"fact=Ad images\">—</p>\n    </article>\n  </section>\n\n  <section class=\"cr-section\" id=\"format\" aria-labelledby=\"format-h\">\n    <h2 class=\"cr-h2\" id=\"format-h\">Format</h2>\n    <article class=\"cr-card\" id=\"format-scorecard\">\n      <h3 class=\"cr-h3\">Format scorecard</h3>\n      <p class=\"cr-muted\">Each format is graded only against your other formats, by rank. CPM and CPA grade the other way round (lowest is best). Hook and hold rate count video ads only.</p>\n      <p class=\"cr-empty\" id=\"format-empty\" data-source=\"sections\" data-field=\"why\" data-where=\"panel=format-scorecard\" hidden>—</p>\n      <p class=\"cr-muted\" id=\"format-how\" data-source=\"sections\" data-field=\"how\" data-where=\"panel=format-scorecard\" hidden>—</p>\n      <div class=\"cr-scroll\">\n        <table class=\"cr-table\" id=\"format-table\" data-source=\"formats\" data-row-key=\"format\">\n          <thead><tr><th data-field=\"name\">Format</th><th data-field=\"ads\" class=\"num\">Ads</th><th data-field=\"spend_share\" class=\"num\">Spend share</th><th data-field=\"ctr\" class=\"num\">CTR</th><th data-field=\"cpm\" class=\"num\">CPM</th><th data-field=\"cpa\" class=\"num\">CPA</th><th data-field=\"roas\" class=\"num\">ROAS</th><th data-field=\"hook_rate\" class=\"num\">Hook rate</th><th data-field=\"hold_rate\" class=\"num\">Hold rate</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </article>\n  </section>\n\n  <section class=\"cr-section\" id=\"white-space\" aria-labelledby=\"white-space-h\">\n    <h2 class=\"cr-h2\" id=\"white-space-h\">White space</h2>\n    <article class=\"cr-card\" id=\"heatmap\">\n      <h3 class=\"cr-h3\">Concept by format</h3>\n      <p class=\"cr-muted\">Shade is spend, the number is ads. Outlined cells are the numbered gaps listed below.</p>\n      <div class=\"cr-chart\" id=\"heatmap-chart\" data-source=\"white-space\"></div>\n      <p class=\"cr-empty\" id=\"heatmap-empty\" data-source=\"sections\" data-field=\"why\" data-where=\"panel=heatmap\" hidden>—</p>\n      <p class=\"cr-muted\" id=\"heatmap-how\" data-source=\"sections\" data-field=\"how\" data-where=\"panel=heatmap\" hidden>—</p>\n    </article>\n    <article class=\"cr-card\" id=\"gaps\">\n      <h3 class=\"cr-h3\">Gaps worth testing</h3>\n      <p class=\"cr-muted\">A hypothesis to test, not a result: an empty or single-ad cell beside a concept or format that performs well in this account.</p>\n      <p class=\"cr-empty\" id=\"gaps-empty\" data-source=\"sections\" data-field=\"why\" data-where=\"panel=gaps\" hidden>—</p>\n      <p class=\"cr-muted\" id=\"gaps-how\" data-source=\"sections\" data-field=\"how\" data-where=\"panel=gaps\" hidden>—</p>\n      <div class=\"cr-scroll\">\n        <table class=\"cr-table\" id=\"gap-table\" data-source=\"gaps\" data-row-key=\"number\">\n          <thead><tr><th data-field=\"number\" class=\"num\">Gap</th><th data-field=\"label\">Cell</th><th data-field=\"why\">Why test it</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </article>\n  </section>\n\n  <section class=\"cr-section\" id=\"briefing\" aria-labelledby=\"briefing-h\">\n    <h2 class=\"cr-h2\" id=\"briefing-h\">Briefing</h2>\n    <article class=\"cr-card\" id=\"briefs\">\n      <h3 class=\"cr-h3\">Briefs</h3>\n      <p class=\"cr-muted\">Brief starters never invent a hook or a message: each carries a prompt for the creative-brief and hook-writer skills.</p>\n      <p class=\"cr-empty\" id=\"briefs-empty\" data-source=\"sections\" data-field=\"why\" data-where=\"panel=briefs\" hidden>—</p>\n      <p class=\"cr-muted\" id=\"briefs-how\" data-source=\"sections\" data-field=\"how\" data-where=\"panel=briefs\" hidden>—</p>\n      <div class=\"cr-scroll\">\n        <table class=\"cr-table\" id=\"brief-table\" data-source=\"briefing\" data-row-key=\"number\">\n          <thead><tr><th data-field=\"number\" class=\"num\">Brief</th><th data-field=\"title\">Title</th><th data-field=\"details\">Details</th><th data-field=\"references\">Reference ads</th><th data-field=\"judged\">How it will be judged</th><th data-field=\"prompt\">Prompt</th></tr></thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </article>\n  </section>\n\n  <footer class=\"cr-section\" id=\"method\" aria-labelledby=\"method-h\">\n    <h2 class=\"cr-h2\" id=\"method-h\">Data and method</h2>\n    <article class=\"cr-card\">\n      <ul class=\"cr-list cr-method\" id=\"method-list\" data-source=\"notes\" data-where=\"section=method\"></ul>\n      <h3 class=\"cr-h3\">Missing data and caveats</h3>\n      <ul class=\"cr-list\" id=\"caveat-list\" data-source=\"notes\" data-where=\"section=caveat\"></ul>\n    </article>\n  </footer>\n</div>\n<script src=\"dashboard.js\"></script>\n"}