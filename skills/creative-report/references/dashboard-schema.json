{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-report/dashboard-schema.json",
  "title": "Creative report: Claude dashboard datasets",
  "description": "What report.py --claude-dashboard writes: one array of flat rows per dataset id. x-version is the schema version (the header dataset repeats it); x-key the column or columns that tell rows apart; x-unit currency (the report currency), percent (already times 100), ratio, count, days, date, per-row (the row's own unit column) or text; x-note the sibling column that says why the value is null, so a value is null exactly when its note is set. Metric columns use the metric ids in creative-context/references/metrics.md.",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "header": {
      "$ref": "#/$defs/header"
    },
    "sections": {
      "$ref": "#/$defs/sections"
    },
    "kpis": {
      "$ref": "#/$defs/kpis"
    },
    "daily": {
      "$ref": "#/$defs/daily"
    },
    "pareto": {
      "$ref": "#/$defs/pareto"
    },
    "pareto-cut": {
      "$ref": "#/$defs/pareto-cut"
    },
    "verdict-board": {
      "$ref": "#/$defs/verdict-board"
    },
    "verdicts": {
      "$ref": "#/$defs/verdicts"
    },
    "formats": {
      "$ref": "#/$defs/formats"
    },
    "white-space": {
      "$ref": "#/$defs/white-space"
    },
    "gaps": {
      "$ref": "#/$defs/gaps"
    },
    "briefing": {
      "$ref": "#/$defs/briefing"
    },
    "notes": {
      "$ref": "#/$defs/notes"
    }
  },
  "$defs": {
    "header": {
      "type": "array",
      "description": "The report header: one fact per row (title, window, scope, currency, source, attribution, completeness, generated, images, schema version).",
      "x-key": "fact",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact",
          "value",
          "tone"
        ],
        "properties": {
          "fact": {
            "type": "string",
            "x-unit": "text"
          },
          "value": {
            "type": "string",
            "x-unit": "text"
          },
          "tone": {
            "type": [
              "string",
              "null"
            ],
            "x-unit": "text",
            "enum": [
              "ok",
              "warn",
              "neutral",
              null
            ],
            "description": "Completeness only: ok reconciled, warn short, neutral not checked."
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "description": "Each HTML panel's state as it rendered; why and how to get the data for an empty one.",
      "x-key": "panel",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tab",
          "panel",
          "heading",
          "state",
          "why",
          "how"
        ],
        "properties": {
          "tab": {
            "type": "string",
            "x-unit": "text"
          },
          "panel": {
            "type": "string",
            "x-unit": "text"
          },
          "heading": {
            "type": "string",
            "x-unit": "text"
          },
          "state": {
            "type": "string",
            "x-unit": "text",
            "enum": [
              "data",
              "empty",
              "partial"
            ]
          },
          "why": {
            "type": [
              "string",
              "null"
            ],
            "x-unit": "text"
          },
          "how": {
            "type": [
              "string",
              "null"
            ],
            "x-unit": "text"
          }
        }
      }
    },
    "kpis": {
      "type": "array",
      "description": "Key numbers, one row per tile; value is in the unit the row names.",
      "x-key": "metric",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "name",
          "unit",
          "value",
          "value_note",
          "shown",
          "detail",
          "change_pct",
          "change_pct_note",
          "change_tone",
          "against"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "x-unit": "text",
            "enum": [
              "spend",
              "impressions",
              "reach",
              "frequency",
              "ctr",
              "cpm",
              "conversions",
              "cpa",
              "conversion_value",
              "roas",
              "hook_rate",
              "hold_rate"
            ],
            "description": "A metric or base field id from creative-context/references/metrics.md."
          },
          "name": {
            "type": "string",
            "x-unit": "text"
          },
          "unit": {
            "type": "string",
            "x-unit": "text",
            "description": "The currency code for money, else empty."
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "x-unit": "per-row",
            "x-note": "value_note",
            "description": "The total for the window: currency for money metrics, percent for rates, ratio for roas and frequency, count otherwise."
          },
          "value_note": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^n/a \\(.+\\)$",
            "x-unit": "text",
            "description": "Why the paired column is null; null when it has a value."
          },
          "shown": {
            "type": "string",
            "x-unit": "text",
            "description": "The value as the HTML tile shows it."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "x-unit": "text"
          },
          "change_pct": {
            "type": [
              "number",
              "null"
            ],
            "x-unit": "percent",
            "x-note": "change_pct_note",
            "description": "Change against the prior period."
          },
          "change_pct_note": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^n/a \\(.+\\)$",
            "x-unit": "text",
            "description": "Why the paired column is null; null when it has a value."
          },
          "change_tone": {
            "type": [
              "string",
              "null"
            ],
            "x-unit": "text",
            "enum": [
              "up",
              "down",
              "flat",
              null
            ]
          },
          "against": {
            "type": "string",
            "x-unit": "text"
          }
        }
      }
    },
    "daily": {
      "type": "array",
      "description": "One row per calendar day and measure; a day with no data is null with a note, never 0.",
      "x-key": "day,metric",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "day",
          "metric",
          "name",
          "kind",
          "unit",
          "value",
          "value_note",
          "average",
