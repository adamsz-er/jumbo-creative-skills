          },
          "name": {
            "type": "string",
            "x-unit": "text"
          },
          "kind": {
            "type": "string",
            "x-unit": "text",
            "enum": [
              "money",
              "pct",
              "x"
            ]
          },
          "unit": {
            "type": "string",
            "x-unit": "text"
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "x-unit": "per-row",
            "x-note": "value_note",
            "description": "Currency for money, percent for pct, ratio for x."
          },
          "value_note": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^n/a \\(.+\\)$",
            "x-unit": "text",
            "description": "Why the paired column is null; null when it has a value."
          },
          "average": {
            "type": [
              "number",
              "null"
            ],
            "x-unit": "per-row",
            "x-note": "average_note",
            "description": "The rolling average, in the value's unit."
          },
          "average_note": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^n/a \\(.+\\)$",
            "x-unit": "text",
            "description": "Why the paired column is null; null when it has a value."
          }
        }
      }
    },
    "pareto": {
      "type": "array",
      "description": "Ads with spend, largest first, with cumulative shares.",
